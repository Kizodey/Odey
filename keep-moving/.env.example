# Copy to .env and fill in to go live. Without a key the app runs in demo mode.
# Get a key: https://console.cloud.google.com — enable "Routes API" and
# "Places API (New)", then restrict the key to those two APIs.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set to 1 to force demo mode even when a key is present.
EXPO_PUBLIC_FORCE_MOCK=
